---
// iOS Form Testing Component
// Import this component into pages with forms for immediate Safari testing
---

<div id="ios-form-tester" style="display: none;" data-test-mode="false">
  <div style="position: fixed; bottom: 20px; right: 20px; background: #0c4a6e; color: white; padding: 1rem; border-radius: 12px; z-index: 9999; font-family: system-ui; max-width: 300px;">
    <h4 style="margin: 0 0 0.5rem 0;">📱 iOS Test Mode</h4>
    <div id="test-results"></div>
    <button onclick="document.getElementById('ios-form-tester').style.display='none'" style="background: transparent; border: 1px solid white; color: white; padding: 0.5rem 1rem; border-radius: 6px; margin-top: 0.5rem; cursor: pointer;">Close</button>
  </div>
</div>

<script>
  // iOS Detection
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || 
                (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  
  // Enable test mode on iOS or when ?test=ios in URL
  const urlParams = new URLSearchParams(window.location.search);
  const testMode = isIOS || urlParams.get('test') === 'ios';
  
  if (testMode) {
    document.getElementById('ios-form-tester').style.display = 'block';
    
    const results = [];
    
    // Test 1: Form elements exist and are visible
    const forms = document.querySelectorAll('form, iframe[src*="jotform"], .jotform-form');
    results.push(`Forms found: ${forms.length}`);
    
    // Test 2: Input types
    const inputs = document.querySelectorAll('input, select, textarea');
    results.push(`Input elements: ${inputs.length}`);
    
    // Test 3: Touch targets
    const smallTargets = Array.from(document.querySelectorAll('button, a, input, select')).filter(el => {
      const rect = el.getBoundingClientRect();
      return rect.width < 44 || rect.height < 44;
    });
    results.push(`Small touch targets (<44px): ${smallTargets.length}`);
    
    // Test 4: Viewport
    const viewport = document.querySelector('meta[name="viewport"]');
    results.push(`Viewport: ${viewport ? viewport.content : 'MISSING'}`);
    
    // Display results
    document.getElementById('test-results').innerHTML = results.map(r => 
      `<div style="font-size: 0.85rem; margin: 0.25rem 0; ${r.includes('MISSING') || r.includes('0') && r.includes('forms') ? 'color: #fbbf24;' : ''}">${r}</div>`
    ).join('');
    
    // Log to console for debugging
    console.log('🔍 iOS Form Test Results:', results);
  }
</script>