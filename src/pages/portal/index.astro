  </style>

  <script>
    // Tab switching
    document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('.dash-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          // Deactivate all tabs
          tabs.forEach(t => t.classList.remove('active'));
          // Activate clicked tab
          tab.classList.add('active');
          // Hide all panels
          document.querySelectorAll('.dash-panel').forEach(p => p.classList.remove('active'));
          // Show target panel
          const target = document.getElementById('tab-' + tab.dataset.tab);
          if (target) target.classList.add('active');
        });
      });
    });

    // Fetch submissions from the standalone API server
    const VM_API = 'https://opendental.drlee.cc3po.com/api';
    const FALLBACK_API = 'https://cdrcgmdvepxwsbqaifxv.supabase.co/functions/v1/jotform-webhook';

    async function tryFetch(url) {
      try {
        const res = await fetch(url, { signal: AbortSignal.timeout(5000) });
        if (res.ok) return res;
      } catch {}
      return null;
    }

    async function loadSubmissions() {
      const container = document.getElementById('submissions-container');
      if (!container) return;

      try {
        let subsRes = await tryFetch(`${VM_API}/submissions?limit=10`);
        let statsRes = await tryFetch(`${VM_API}/stats`);

        if (!subsRes) {
          subsRes = await tryFetch(`${FALLBACK_API}?action=submissions&limit=10`);
          statsRes = await tryFetch(`${FALLBACK_API}?action=stats`);
        }

        if (!subsRes) throw new Error('No API available');

        console.log('Submissions API connected, fetching data...');
        const subs = await subsRes.json();
        const stats = statsRes ? await statsRes.json() : {};

        console.log('Submissions count:', subs.submissions?.length);
        console.log('Stats:', JSON.stringify(stats).substring(0, 100));

        if (!subs.submissions || subs.submissions.length === 0) {
          console.log('No submissions found in API response');
          return;
        }

        // Count unique forms from submissions data
        const formCounts = {};
        subs.submissions.forEach(s => {
          const name = s.form_name || 'Form';
          formCounts[name] = (formCounts[name] || 0) + 1;
        });
        const topForms = Object.entries(formCounts).slice(0, 2);

        let html = '<div class="submissions-stats">';
        html += `<div class="sub-stat"><div class="sub-stat-number">${stats.total_submissions || subs.submissions.length}</div><div class="sub-stat-label">Total Submissions</div></div>`;
        html += `<div class="sub-stat"><div class="sub-stat-number">${stats.new_submissions || subs.submissions.filter(s => s.status === 'new').length}</div><div class="sub-stat-label">Unread</div></div>`;
        topForms.forEach(([name, count]) => {
          html += `<div class="sub-stat"><div class="sub-stat-number">${count}</div><div class="sub-stat-label">${name}</div></div>`;
        });
        // Pad remaining stat slots if fewer than 4
        const padCount = 4 - (2 + topForms.length);
        for (let i = 0; i < padCount; i++) {
          html += `<div class="sub-stat" style="visibility:hidden;"><div class="sub-stat-number">—</div><div class="sub-stat-label">&nbsp;</div></div>`;
        }
        html += '</div>';

        html += '<div class="submissions-table-wrap"><table class="submissions-table"><thead><tr>';
        html += '<th style="width:20px;"></th><th>Form</th><th>Patient</th><th>Email</th><th>Date</th><th>Status</th><th style="width:36px;"></th>';
        html += '</tr></thead><tbody>';
        subs.submissions.forEach(s => {
          const time = new Date(s.created_at || s.submitted_at).toLocaleString('en-US', {
            month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
          });
          const isNew = s.status === 'new';
          html += `
            <tr class="${isNew ? 'new' : ''}">
              <td><span class="sub-dot ${isNew ? 'new' : 'read'}"></span></td>
              <td><span class="sub-form-name">${s.form_name || 'Form'}</span></td>
              <td><span class="sub-patient-name">${s.name || s.patient_name || 'Unknown'}</span></td>
              <td><span class="sub-email">${s.email || '—'}</span></td>
              <td><span class="sub-time">${time}</span></td>
              <td><span class="sub-status-badge ${isNew ? 'new' : 'read'}">${isNew ? 'New' : 'Read'}</span></td>
              <td><a href="/portal/submission-view/?id=${s.id}" class="sub-dl-btn" title="View & Download" target="_blank">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              </a></td>
            </tr>
          `;
        });
        html += '</tbody></table></div>';

        container.innerHTML = html;
      } catch (err) {
        console.log('Forms API not available yet:', err.message);
      }
    }

    document.addEventListener('DOMContentLoaded', loadSubmissions);

    // ===== LIVE DASHBOARD DATA =====
    async function loadDashboard() {
      try {
        const res = await fetch('https://portal.dralanlee.com/api/dashboard');
        if (!res.ok) throw new Error('Dashboard API unavailable');
        const data = await res.json();

        // Update KPIs
        const kpiPatients = document.querySelector('#kpi-patients');
        const kpiNewPatients = document.querySelector('#kpi-new-patients');
        const kpiOverdueLabs = document.querySelector('#kpi-overdue-labs');
        const kpiInProgressLabs = document.querySelector('#kpi-in-progress-labs');
        const kpiTreatmentPatients = document.querySelector('#kpi-treatment-patients');
        const kpiTreatmentTotal = document.querySelector('#kpi-treatment-total');

        if (kpiPatients) kpiPatients.textContent = data.kpis.patientsToday;
        if (kpiNewPatients) kpiNewPatients.textContent = data.kpis.newPatients;
        if (kpiOverdueLabs) kpiOverdueLabs.textContent = data.kpis.overdueLabCases;
        if (kpiInProgressLabs) kpiInProgressLabs.textContent = data.kpis.inProgressLabCases;
        if (kpiTreatmentPatients) kpiTreatmentPatients.textContent = data.kpis.pendingTreatmentPatients;
        if (kpiTreatmentTotal) kpiTreatmentTotal.textContent = '$' + (data.kpis.pendingTreatmentTotal || 0).toLocaleString();

        // Update Today's Schedule
        const scheduleEl = document.querySelector('#live-schedule');
        if (scheduleEl && data.appointments) {
          let html = '';
          data.appointments.forEach(a => {
            const statusClass = a.status === 3 ? 'cancelled' : a.isHygiene ? 'hygiene' : a.isNew ? 'new-patient' : '';
            const badge = a.isNew ? '<span class="badge badge-new">NEW</span>' : a.isHygiene ? '<span class="badge badge-hygiene">HYG</span>' : '';
            const noteSnippet = a.note ? `<div class="schedule-note">${a.note.substring(0, 80)}${a.note.length > 80 ? '...' : ''}</div>` : '';
            html += `<div class="schedule-row ${statusClass}">
              <div class="schedule-time">${a.time}</div>
              <div class="schedule-info">
                <div class="schedule-name">${a.name} ${badge}</div>
                <div class="schedule-proc">${a.procedure || 'Checkup'}</div>
                ${noteSnippet}
              </div>
              <div class="schedule-op">Op ${a.op}</div>
            </div>`;
          });
          scheduleEl.innerHTML = html || '<div class="schedule-empty">No appointments today</div>';
        }

        // Update Lab Cases
        try {
          const labRes = await fetch('https://portal.dralanlee.com/api/dashboard/lab-cases');
          if (labRes.ok) {
            const labData = await labRes.json();
            const labEl = document.querySelector('#live-lab-cases');
            if (labEl && labData.overdue) {
              let html = '';
              labData.overdue.slice(0, 10).forEach(c => {
                const dueDate = new Date(c.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'year', year: 'numeric' });
                html += `<div class="lab-case-row overdue">
                  <div class="lab-case-patient">${c.patient}</div>
                  <div class="lab-case-desc">${c.instructions || c.lab}</div>
                  <div class="lab-case-meta">
                    <span class="lab-lab">${c.lab}</span>
                    <span class="lab-due">${c.daysOverdue}d overdue</span>
                  </div>
                </div>`;
              });
              labEl.innerHTML = html || '<div class="lab-empty">No overdue lab cases</div>';
            }
          }
        } catch(e) { console.log('Lab cases fetch error:', e); }

        // Mark dashboard as live
        document.querySelectorAll('.dashboard-source').forEach(el => {
          el.textContent = 'Live from OpenDental';
          el.classList.add('live');
        });

      } catch (err) {
        console.log('Dashboard API not available:', err.message);
        document.querySelectorAll('.dashboard-source').forEach(el => {
          el.textContent = 'Sample data (API unavailable)';
        });
      }
    }

    loadDashboard();

    // ===== LIVE TREATMENT PLANS =====
    async function loadTreatmentPlans() {
      try {
        const res = await fetch('https://portal.dralanlee.com/api/dashboard/treatment-plans');
        if (!res.ok) throw new Error('Treatment plans API unavailable');
        const data = await res.json();

        // Update treatment plan section
        const txplanList = document.querySelector('.txplan-list');
        if (txplanList && data.patients) {
          let html = '';
          data.patients.slice(0, 15).forEach(p => {
            const totalFee = p.totalFee.toLocaleString();
            const procCount = p.procedures.length;
            const topProcs = p.procedures.slice(0, 3).map(pr =>
              `<span style="display:inline-block;background:#e0f2fe;color:#075985;padding:2px 8px;border-radius:4px;font-size:0.75rem;margin:2px;">${pr.code} ${pr.description}</span>`
            ).join('');
            html += `<div class="txplan-card planned">
              <div class="txplan-status">🟡</div>
              <div class="txplan-info">
                <div class="txplan-name">${p.name}</div>
                <div class="txplan-treatment">${procCount} procedure${procCount !== 1 ? 's' : ''}: ${topProcs}</div>
                <div class="txplan-meta">
                  <span class="txplan-fee">$${totalFee}</span>
                  <span class="txplan-date">Potential revenue</span>
                </div>
              </div>
              <div class="txplan-actions">
                <span class="txplan-badge planned">Pending</span>
              </div>
            </div>`;
          });
          txplanList.innerHTML = html || '<div class="schedule-empty">No pending treatment plans</div>';

          // Update stats
          const pendingStat = document.querySelector('#kpi-treatment-patients');
          if (pendingStat) pendingStat.textContent = data.patientCount;
          const totalStat = document.querySelector('#kpi-treatment-total');
          if (totalStat) totalStat.textContent = '$' + (data.totalPotential || 0).toLocaleString();
          // Update stats in section header too
          const pendingCountEl = document.querySelector('#txplan-pending-count');
          if (pendingCountEl) pendingCountEl.textContent = data.patientCount;
          const potentialTotalEl = document.querySelector('#txplan-potential-total');
          if (potentialTotalEl) potentialTotalEl.textContent = '$' + (data.totalPotential || 0).toLocaleString();
        }

        // Mark treatment section as live
        const txBanner = document.querySelector('.alt-bg .demo-banner');
        if (txBanner) {
          txBanner.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 12l2 2 4-4"></path></svg> <span class="dashboard-source live">Live from OpenDental · ${data.patientCount} patients with pending treatment</span>`;
        }
      } catch (err) {
        console.log('Treatment plans API not available:', err.message);
      }
    }

    loadTreatmentPlans();

    // ===== LIVE PATIENTS LOOKUP =====
    let patientsCurrentPage = 1;
    async function loadPatients(page = 1, search = '') {
      try {
        const params = new URLSearchParams({ page: String(page) });
        if (search) params.set('search', search);
        const res = await fetch('https://portal.dralanlee.com/api/dashboard/patients?' + params);
        if (!res.ok) throw new Error('Patients API unavailable');
        const data = await res.json();

        // Update total count
        const totalEl = document.querySelector('#patients-total-count');
        if (totalEl) totalEl.textContent = data.total.toLocaleString();

        // Render patient rows
        const listEl = document.querySelector('#patients-list');
        if (listEl && data.patients) {
          let html = '';
          data.patients.forEach(p => {
            const balClass = p.balance > 0 ? 'color: #dc2626; font-weight: 600;' : 'color: var(--neutral-500);';
            const insBadge = p.hasInsurance
              ? '<span style="display:inline-block;background:#dcfce7;color:#166534;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;">Insured</span>'
              : '<span style="display:inline-block;background:#fef2f2;color:#991b1b;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;">No Ins</span>';
            const labBadge = p.overdueLabs > 0
              ? ` <span style="display:inline-block;background:#fef2f2;color:#991b1b;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;">${p.overdueLabs} overdue lab${p.overdueLabs !== 1 ? 's' : ''}</span>`
              : '';
            const apptBadge = p.upcomingAppointments > 0
              ? ` <span style="display:inline-block;background:#e0f2fe;color:#075985;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;">${p.upcomingAppointments} upcoming</span>`
              : '';
            const txBadge = p.pendingProcedures > 0
              ? ` <span style="display:inline-block;background:#fef9c3;color:#854d0e;padding:2px 8px;border-radius:4px;font-size:0.7rem;font-weight:600;">${p.pendingProcedures} proc${p.pendingProcedures !== 1 ? 's' : ''} ($${p.pendingTotal.toLocaleString()})</span>`
              : '';

            html += `<div style="background: white; border: 1px solid var(--neutral-200); border-radius: 10px; padding: 0.8rem 1rem; display: flex; align-items: center; gap: 0.75rem; transition: box-shadow 0.2s;">
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                  <span style="font-weight: 600; font-size: 0.9rem; color: var(--neutral-900);">${p.name}</span>
                  ${insBadge}
                  ${labBadge}
                  ${apptBadge}
                  ${txBadge}
                </div>
                <div style="display: flex; gap: 1rem; margin-top: 0.3rem; font-size: 0.78rem; color: var(--neutral-500);">
                  <span>DOB: ${p.birthdate || '—'}</span>
                  <span style="${balClass}">Balance: $${p.balance.toLocaleString()}</span>
                </div>
              </div>
            </div>`;
          });
          listEl.innerHTML = html || '<div class="schedule-empty">No patients found</div>';
        }

        // Pagination
        const pagEl = document.querySelector('#patients-pagination');
        if (pagEl && data.totalPages > 1) {
          let pagHtml = '';
          for (let i = 1; i <= data.totalPages; i++) {
            const active = i === page ? 'background: var(--primary); color: white; border-color: var(--primary);' : 'background: white; color: var(--neutral-700); border-color: var(--neutral-200);';
            pagHtml += `<button onclick="loadPatients(${i}, document.querySelector('#patient-search').value)" style="${active} padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.85rem; cursor: pointer; border: 1px solid;">${i}</button>`;
          }
          pagEl.innerHTML = pagHtml;
        } else if (pagEl) {
          pagEl.innerHTML = '';
        }

        // Mark as live
        const banner = document.querySelector('#patients-list').closest('.section-pad').querySelector('.dashboard-source');
        if (banner) {
          banner.textContent = `Live from OpenDental · ${data.total.toLocaleString()} active patients`;
          banner.classList.add('live');
        }
      } catch (err) {
        console.log('Patients API not available:', err.message);
      }
    }

    // Load patients on page load
    loadPatients(1);

    // Patient search with debounce
    let patientSearchTimeout;
    document.querySelector('#patient-search')?.addEventListener('input', (e) => {
      clearTimeout(patientSearchTimeout);
      patientSearchTimeout = setTimeout(() => {
        loadPatients(1, e.target.value);
      }, 300);
    });
  </script>
</Layout>
