    .cc3po-card a { color: var(--primary-700); text-decoration: underline; }
    .cc3po-card .btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.55rem 1.25rem; background: linear-gradient(135deg, var(--primary-700), #1e40af); color: white; border-radius: var(--radius-md); font-weight: 600; font-size: 0.85rem; text-decoration: none; transition: all 0.2s ease; box-shadow: 0 2px 4px rgba(12,74,110,0.15); }
    .cc3po-card .btn-primary:hover { background: linear-gradient(135deg, #0c4a6e, #1e3a5f); box-shadow: 0 4px 8px rgba(12,74,110,0.2); transform: translateY(-1px); }

    /* ============================================
       RESPONSIVE BREAKPOINTS
       ============================================ */

