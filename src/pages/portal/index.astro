---
import Layout from '../../layouts/Layout.astro';
import scores from '../../data/compliance-scores.json';
import huddle from '../../data/morning-huddle.json';
import tasks from '../../data/task-board.json';
import treatmentPlans from '../../data/treatment-plans.json';
import patientSources from '../../data/patient-sources.json';
import reviews from '../../data/reviews.json';

const title = 'Client Portal | Dr. Alan S. Lee, DDS';
const description = 'Secure client portal for Dr. Alan S. Lee, DDS. View compliance status, submit requests, and access practice resources.';
const canonicalUrl = 'https://dralanlee.com/portal/';

const { overall, grade, lastAudited, auditedBy, categories } = scores;
const catEntries = Object.entries(categories);

const todayPatients = huddle.patients;
const labCases = huddle.labCases;
const taskList = tasks.tasks;
const pendingPlans = treatmentPlans.patients.filter(p => p.status === 'pending');
const pendingTotal = pendingPlans.reduce((sum, p) => sum + p.fee, 0);
const sourceTotal = patientSources.sources.reduce((sum, s) => sum + s.count, 0);
const reviewRating = reviews.averageRating;
const pendingTasks = taskList.filter(t => t.status !== 'completed');
const completedTasks = taskList.filter(t => t.status === 'completed');
const todayDate = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const forms = [
  { id: '260202986387060', name: 'Schedule Appointment', desc: 'Book your next visit', page: '/schedule-appointment/', status: 'active' },
  { id: '261347052218149', name: 'Consent for Treatment', desc: 'Patient consent & agreement', page: '/forms-library/', status: 'active' },
  { id: '261346489311156', name: 'Records Release Authorization', desc: 'Release medical records', page: '/forms-library/', status: 'active' },
  { id: '261351664337155', name: 'General Contact', desc: 'Send a message to the office', page: '/contact/', status: 'active' },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl}>
  <section class="legal-hero" data-animate>
    <div class="container-wide">
      <div class="section-label">Client Portal</div>
      <h1 class="section-title">Dr. Alan S. Lee, DDS</h1>
      <p class="legal-hero-subtitle">Your practice dashboard — compliance, forms, and practice tools in one place.</p>
    </div>
  </section>

  <!-- Dashboard Navigation Tabs -->
  <nav class="dash-nav" data-animate>
    <div class="container-narrow">
      <div class="dash-tabs">
        <button class="dash-tab active" data-tab="overview">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Overview
        </button>
        <button class="dash-tab" data-tab="patients">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          Patients
        </button>
        <button class="dash-tab" data-tab="operations">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          Operations
        </button>
        <button class="dash-tab" data-tab="compliance">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Compliance
        </button>
        <button class="dash-tab" data-tab="analytics">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          Analytics
        </button>
        <button class="dash-tab" data-tab="resources">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          Resources
        </button>
      </div>
    </div>
  </nav>

  <!-- ===== TAB: OVERVIEW ===== -->
  <div class="dash-panel active" id="tab-overview">

    <!-- KPI Bar -->
    <section class="section-pad" data-animate>
      <div class="container-narrow">
        <div class="kpi-bar">
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-number">{overall}<span class="kpi-suffix">/100</span></div>
              <div class="kpi-grade grade-a">A</div>
            </div>
            <div class="kpi-label">Compliance Score</div>
            <div class="kpi-sub">Last audited {lastAudited}</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-number">{todayPatients.filter(p => p.name !== 'LUNCH').length}</div>
            </div>
            <div class="kpi-label">Today's Patients</div>
            <div class="kpi-sub">{todayDate}</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-number">{pendingPlans.length}</div>
            </div>
            <div class="kpi-label">Pending Treatment Plans</div>
            <div class="kpi-sub">${pendingTotal.toLocaleString()} potential</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-number">{labCases.filter(c => c.status === 'overdue').length}</div>
            </div>
            <div class="kpi-label">Overdue Lab Cases</div>
            <div class="kpi-sub">{labCases.filter(c => c.status === 'in_progress').length} in progress</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-top">
              <div class="kpi-number">{reviewRating}</div>
            </div>
            <div class="kpi-label">Average Review</div>
            <div class="kpi-sub">{reviews.totalReviews} reviews</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Activity + Quick Actions -->
    <section class="section-pad alt-bg" data-animate>
      <div class="container-narrow">
        <div class="overview-grid">
          <div class="overview-main">
            <h2 class="section-heading">Recent Activity</h2>
            <div class="activity-timeline">
              <div class="activity-item highlight">
                <div class="activity-dot green"></div>
                <div class="activity-content">
                  <div class="activity-title">Compliance Score Updated — 96/100 (Grade A)</div>
                  <div class="activity-desc">CSP tightened, Cookie Policy added, all forms verified working.</div>
                  <div class="activity-meta">Today at 5:42 AM · CC3PO Atlas</div>
                </div>
              </div>
              <div class="activity-item">
                <div class="activity-dot green"></div>
                <div class="activity-content">
                  <div class="activity-title">Submit Buttons Added to 2 Patient Forms</div>
                  <div class="activity-desc">Consent for Treatment + Records Release Authorization</div>
                  <div class="activity-meta">Today at 5:30 AM · JotForm Builder</div>
                </div>
              </div>
              <div class="activity-item">
                <div class="activity-dot green"></div>
                <div class="activity-content">
                  <div class="activity-title">All 4 Form Pages Migrated to Direct Iframes</div>
                  <div class="activity-desc">No more JotForm signup/login overlays</div>
                  <div class="activity-meta">Today at 5:07 AM · CC3PO Atlas</div>
                </div>
              </div>
              <div class="activity-item">
                <div class="activity-dot blue"></div>
                <div class="activity-content">
                  <div class="activity-title">CSP Security Header Tightened</div>
                  <div class="activity-desc">Removed 'unsafe-eval' — stronger XSS protection</div>
                  <div class="activity-meta">Today at 5:39 AM · CC3PO Atlas</div>
                </div>
              </div>
            </div>
          </div>
          <div class="overview-side">
            <h2 class="section-heading">Quick Actions</h2>
            <div class="actions-stack">
              <a href="/portal/support/" class="action-row">
                <div class="action-icon-sm blue">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <div class="action-row-text">
                  <span class="action-row-title">Request Support</span>
                  <span class="action-row-desc">Website changes, questions, or issues</span>
                </div>
                <svg class="action-row-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <a href="/schedule-appointment/" class="action-row">
                <div class="action-icon-sm green">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </div>
                <div class="action-row-text">
                  <span class="action-row-title">Book Appointment</span>
                  <span class="action-row-desc">Test the patient booking flow</span>
                </div>
                <svg class="action-row-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <a href="/contact/" class="action-row">
                <div class="action-icon-sm orange">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div class="action-row-text">
                  <span class="action-row-title">Contact Office</span>
                  <span class="action-row-desc">Call (209) 239-2990 or send a message</span>
                </div>
                <svg class="action-row-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
              <a href="/portal/guide/" class="action-row">
                <div class="action-icon-sm purple">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div class="action-row-text">
                  <span class="action-row-title">Google Workspace Guide</span>
                  <span class="action-row-desc">Email & tools transition guide</span>
                </div>
                <svg class="action-row-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>

            <div class="overview-reminders">
              <h3>Upcoming</h3>
              <div class="reminder-row">
                <div class="reminder-dot warning"></div>
                <div class="reminder-row-text">
                  <span class="reminder-row-title">SSL Certificate Renewal</span>
                  <span class="reminder-row-date">Aug 13</span>
                </div>
              </div>
              <div class="reminder-row">
                <div class="reminder-dot info"></div>
                <div class="reminder-row-text">
                  <span class="reminder-row-title">Next Full Compliance Audit</span>
                  <span class="reminder-row-date">Jul 23</span>
                </div>
              </div>
              <div class="reminder-row">
                <div class="reminder-dot success"></div>
                <div class="reminder-row-text">
                  <span class="reminder-row-title">Weekly Compliance Scan</span>
                  <span class="reminder-row-date">Auto</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Patient Forms Hub -->
    <section class="section-pad" data-animate>
      <div class="container-narrow">
        <h2 class="section-heading">Patient Forms</h2>
        <p class="section-description">All forms are HIPAA-secure. Submissions go to <strong>staff@dralanlee.com</strong>.</p>
        <div class="forms-hub">
          {forms.map(f => (
            <a href={f.page} class="form-card">
              <div class="form-status-dot active"></div>
              <div class="form-info">
                <div class="form-name">{f.name}</div>
                <div class="form-desc">{f.desc}</div>
              </div>
              <div class="form-meta">
                <span class="form-badge">Active</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </a>
          ))}
        </div>
        <div class="forms-actions">
          <a href="/forms-library/" class="btn-secondary">View All Forms</a>
          <a href="https://www.jotform.com/myforms/" target="_blank" rel="noopener noreferrer" class="btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            Open JotForm Dashboard
          </a>
        </div>
      </div>
    </section>

    <!-- Recent Submissions -->
    <section class="section-pad alt-bg" data-animate id="submissions-section" style="margin-bottom: 3rem;">
      <div class="container-narrow">
        <h2 class="section-heading">Recent Form Submissions</h2>
        <p class="section-description">Patient submissions received through your online forms.</p>
        <div id="submissions-container">
          <div class="submissions-placeholder">
            <div class="placeholder-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            </div>
            <h3>Waiting for submissions</h3>
            <p>Once patients start filling out forms, submissions will appear here automatically.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- ===== TAB: PATIENTS ===== -->
  <div class="dash-panel" id="tab-patients">

    <!-- Morning Huddle -->
    <section class="section-pad" data-animate>
      <div class="container-narrow">
        <div class="panel-header">
          <div>
            <h2 class="section-heading">Morning Huddle</h2>
            <p class="section-description">{todayDate} · {todayPatients.filter(p => p.name !== 'LUNCH').length} patients today</p>
          </div>
          <div class="panel-badges">
            <span class="panel-badge birthday">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
              {huddle.staffBirthdays.length} Birthday{huddle.staffBirthdays.length !== 1 ? 's' : ''}
            </span>
            <span class="panel-badge alert">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              {todayPatients.filter(p => p.medicalAlerts).length} Medical Alerts
            </span>
          </div>
        </div>
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span>Demo data — will connect to Open Dental after cloud migration</span>
        </div>
        <div class="huddle-table-wrap">
          <table class="huddle-table">
            <thead>
              <tr>
                <th>Time</th>
                <th>Patient</th>
                <th>Procedure</th>
                <th>Insurance</th>
                <th>Balance</th>
                <th>Alerts</th>
              </tr>
            </thead>
            <tbody>
              {todayPatients.map(p => (
                <tr class={p.name === 'LUNCH' ? 'huddle-lunch' : ''}>
                  <td class="huddle-time">{p.time}</td>
                  <td class="huddle-patient">{p.name}{p.birthday && <span class="birthday-badge">🎂</span>}</td>
                  <td class="huddle-proc">{p.procedure}</td>
                  <td class="huddle-ins">{p.insurance || '—'}</td>
                  <td class="huddle-balance">{p.balance !== null ? (p.balance > 0 ? <span class="balance-due">${p.balance}</span> : <span class="balance-paid">$0</span>) : '—'}</td>
                  <td class="huddle-alerts">{p.medicalAlerts ? <span class="alert-tag">{p.medicalAlerts}</span> : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {huddle.notes && (
          <div class="huddle-notes">
            <div class="huddle-notes-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <p>{huddle.notes}</p>
          </div>
        )}
      </div>
    </section>

    <!-- Treatment Plan Follow-Up -->
    <section class="section-pad alt-bg" data-animate>
      <div class="container-narrow">
        <div class="panel-header">
          <div>
            <h2 class="section-heading">Treatment Plan Follow-Up</h2>
            <p class="section-description">Patients presented treatment who haven't scheduled yet.</p>
          </div>
          <div class="panel-stats">
            <div class="panel-stat">
              <span class="panel-stat-num">{pendingPlans.length}</span>
              <span class="panel-stat-label">Pending</span>
            </div>
            <div class="panel-stat">
              <span class="panel-stat-num">${pendingTotal.toLocaleString()}</span>
              <span class="panel-stat-label">Potential Revenue</span>
            </div>
          </div>
        </div>
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span>Demo data — staff can start tracking real treatment plans here</span>
        </div>
        <div class="txplan-list">
          {treatmentPlans.patients.map(p => {
            const statusIcon = p.status === 'scheduled' ? '🟢' : p.status === 'declined' ? '⚪' : '🟡';
            const statusLabel = p.status === 'scheduled' ? 'Scheduled' : p.status === 'declined' ? 'Declined' : 'Pending';
            return (
              <div class={`txplan-card ${p.status}`}>
                <div class="txplan-status">{statusIcon}</div>
                <div class="txplan-info">
                  <div class="txplan-name">{p.name}</div>
                  <div class="txplan-treatment">{p.treatment}</div>
                  <div class="txplan-meta">
                    <span class="txplan-fee">${p.fee.toLocaleString()}</span>
                    <span class="txplan-ins">{p.insuranceCoverage}</span>
                    <span class="txplan-date">Presented: {p.presentedDate}</span>
                  </div>
                  {p.notes && <div class="txplan-notes">{p.notes}</div>}
                </div>
                <div class="txplan-actions">
                  <span class="txplan-badge {p.status}">{statusLabel}</span>
                  {p.phone && <span class="txplan-phone">{p.phone}</span>}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- New Patient Sources -->
    <section class="section-pad" data-animate>
      <div class="container-narrow">
        <h2 class="section-heading">New Patient Sources</h2>
        <p class="section-description">{patientSources.totalNewPatients} new patients in {patientSources.month}</p>
        <div class="demo-banner">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span>Demo data — Angelina can log new patient sources daily</span>
        </div>
        <div class="sources-grid">
          <div class="sources-chart">
