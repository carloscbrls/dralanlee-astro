    }
    .consent-gate-note svg {
      color: #059669;
    }
  </style>

  <script>
    // Success-message detection — JotForm redirects back with ?thanks=1 or postMessages
    (function() {
      const params = new URLSearchParams(window.location.search);
      const isSuccess = params.has('thanks') || params.get('submission') === 'success';

      function showSuccess() {
        const el = document.getElementById('form-success');
        if (el && el.hidden) {
          el.hidden = false;
          el.setAttribute('tabindex', '-1');
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          el.focus({ preventScroll: true });
          document.querySelectorAll('.jotform-embed').forEach(f => {
            f.style.display = 'none';
          });
        }
      }

      if (isSuccess) {
        setTimeout(showSuccess, 300);
      }

      window.addEventListener('message', (e) => {
        if (!e.origin || !e.origin.endsWith('jotform.com')) return;
        const data = (typeof e.data === 'string') ? e.data : JSON.stringify(e.data || {});
        if (/submission\s*complete|form\s*submitted|thank\s*you/i.test(data)) {
          showSuccess();
        }
      });
    })();

    // ===== CONSENT GATE LOGIC =====
    // Shows a consent gate before loading JotForm. Stores consent in sessionStorage.
    (function() {
      const CONSENT_KEY = 'drlee_hipaa_consent';
      const gate = document.getElementById('consent-gate');
      const check = document.getElementById('consent-check');
      const btn = document.getElementById('consent-btn');
      const embed = document.getElementById('appointment-form-container');

      function hasConsent() {
        try {
          return sessionStorage.getItem(CONSENT_KEY) === 'true';
        } catch (e) {
          return false;
        }
      }

      function giveConsent() {
        try {
          sessionStorage.setItem(CONSENT_KEY, 'true');
        } catch (e) {
          // sessionStorage may be disabled; continue anyway
        }
        if (gate) gate.style.display = 'none';
        if (embed) {
          embed.style.display = 'block';
          embed.classList.add('consent-given');
        }
        // Focus first form field for accessibility
        setTimeout(() => {
          const firstInput = document.querySelector('.jotform-embed input, .jotform-embed select, .jotform-embed textarea');
          if (firstInput) firstInput.focus();
        }, 500);
      }

      if (hasConsent()) {
        giveConsent();
        return;
      }

      if (check && btn) {
        check.addEventListener('change', () => {
          btn.disabled = !check.checked;
          btn.setAttribute('aria-disabled', String(!check.checked));
        });

        btn.addEventListener('click', () => {
          if (check.checked) giveConsent();
        });

        // Allow Enter key to submit when checkbox is focused
        check.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            check.checked = !check.checked;
            btn.disabled = !check.checked;
            btn.setAttribute('aria-disabled', String(!check.checked));
            if (check.checked) giveConsent();
          }
        });
      }
    })();
  </script>

</Layout>