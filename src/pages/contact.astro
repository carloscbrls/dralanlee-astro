  <script>
    // Tab switching for contact forms
    document.querySelectorAll('.form-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        // Update tabs
        document.querySelectorAll('.form-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        // Update panels
        document.querySelectorAll('.form-panel').forEach(p => {
          p.classList.remove('active');
          p.style.visibility = 'hidden';
        });
        const panel = document.getElementById('panel-' + target);
        panel.classList.add('active');
        panel.style.visibility = 'visible';
        
        // Force JotForm iframe resize after panel becomes visible
        setTimeout(() => {
          const iframe = panel.querySelector('iframe');
          if (iframe) {
            iframe.style.height = iframe.contentWindow?.document?.body?.scrollHeight + 'px' || '600px';
          }
        }, 500);
      });
    });

    // HIPAA Compliance Enhancement - Inject consent checkbox after form loads
    function injectHIPAACompliance() {
      // Wait for JotForm to render
      setTimeout(() => {
        const forms = document.querySelectorAll('.jotform-embed');
        forms.forEach(formContainer => {
          const jotformWrapper = formContainer.querySelector('[id^="2602"], [id^="2613"]');
          if (jotformWrapper) {
            // Check if consent checkbox already exists
            if (!formContainer.querySelector('.hipaa-consent-container')) {
              const consentDiv = document.createElement('div');
              consentDiv.className = 'hipaa-consent-container';
              consentDiv.innerHTML = `
                <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
                  <input type="checkbox" required style="margin-top: 2px; flex-shrink: 0;" 
                         onchange="this.setCustomValidity(this.checked ? '' : 'You must consent to proceed with your inquiry.')">
                  <span>I consent to being contacted regarding my dental inquiry. I understand my information will be handled per the <a href="/hipaa-privacy/" target="_blank" style="color: #059669; text-decoration: underline;">HIPAA Notice of Privacy Practices</a>. *</span>
                </label>
              `;
              
              // Insert before submit button or at end of form
              const submitButton = jotformWrapper.querySelector('.form-buttons-wrapper');
              if (submitButton) {
                submitButton.parentNode.insertBefore(consentDiv, submitButton);
              } else {
                formContainer.appendChild(consentDiv);
              }
            }
            
            // Add encryption notice
            if (!formContainer.querySelector('.encryption-notice')) {
              const encryptionDiv = document.createElement('div');
              encryptionDiv.className = 'encryption-notice';
              encryptionDiv.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <span>This form uses HIPAA-compliant encryption. Your data is protected end-to-end.</span>
              `;
              
              const submitButton = jotformWrapper.querySelector('.form-buttons-wrapper');
              if (submitButton) {
                submitButton.parentNode.insertBefore(encryptionDiv, submitButton);
              }
            }
          }
        });
      }, 3000); // Wait 3 seconds for JotForm to fully render
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectHIPAACompliance);
    } else {
      injectHIPAACompliance();
    }

    // Also run when tab is switched (forms may re-render)
    document.querySelectorAll('.form-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        setTimeout(injectHIPAACompliance, 1000);
      });
    });

    // Success-message detection — JotForm redirects back with ?thanks=1 or postMessages
    (function() {
      const params = new URLSearchParams(window.location.search);
      const isSuccess = params.has('thanks') || params.get('submission') === 'success';

      function showSuccess() {
        const el = document.getElementById('form-success');
        if (el && el.hidden) {
          el.hidden = false;
          el.setAttribute('tabindex', '-1');
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          el.focus({ preventScroll: true });
          document.querySelectorAll('.jotform-embed').forEach(f => {
            f.style.display = 'none';
          });
        }
      }

      if (isSuccess) {
        // Slight delay to let JotForm finish any postMessage
        setTimeout(showSuccess, 300);
      }

      // Also catch JotForm postMessage events as a fallback
      window.addEventListener('message', (e) => {
        if (!e.origin || !e.origin.endsWith('jotform.com')) return;
        const data = (typeof e.data === 'string') ? e.data : JSON.stringify(e.data || {});
        if (/submission\s*complete|form\s*submitted|thank\s*you/i.test(data)) {
          showSuccess();
        }
      });
    })();
    // ===== CONSENT GATE LOGIC =====
    // Shows a consent gate before loading JotForm. Stores consent in sessionStorage.
    (function() {
      const CONSENT_KEY = 'drlee_hipaa_consent';
      const gate = document.getElementById('consent-gate');
      const check = document.getElementById('consent-check');
      const btn = document.getElementById('consent-btn');
      const panels = document.querySelectorAll('.form-panel[data-requires-consent]');

      function hasConsent() {
        try {
          return sessionStorage.getItem(CONSENT_KEY) === 'true';
        } catch (e) {
          return false;
        }
      }

      function giveConsent() {
        try {
          sessionStorage.setItem(CONSENT_KEY, 'true');
        } catch (e) {
          // sessionStorage may be disabled; continue anyway
        }
        if (gate) gate.style.display = 'none';
        panels.forEach(p => {
          p.classList.add('consent-given');
          const embed = p.querySelector('.jotform-embed');
          if (embed) embed.style.display = 'block';
        });
        // Focus first form field for accessibility
        setTimeout(() => {
          const firstInput = document.querySelector('.jotform-embed input, .jotform-embed select, .jotform-embed textarea');
          if (firstInput) firstInput.focus();
        }, 500);
      }

      if (hasConsent()) {
        giveConsent();
        return;
      }

      if (check && btn) {
        check.addEventListener('change', () => {
          btn.disabled = !check.checked;
          btn.setAttribute('aria-disabled', String(!check.checked));
        });

        btn.addEventListener('click', () => {
          if (check.checked) giveConsent();
        });

        // Allow Enter key to submit when checkbox is focused
        check.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            check.checked = !check.checked;
            btn.disabled = !check.checked;
            btn.setAttribute('aria-disabled', String(!check.checked));
            if (check.checked) giveConsent();
          }
        });
      }
    })();
  </script>

