---
import Layout from '../layouts/Layout.astro';

const title = 'Contact Us | Dr. Alan S. Lee, DDS';
const description = 'Contact Dr. Alan S. Lee, DDS in Manteca, CA. Call (209) 239-2990, visit us at 715 N Main St, or send us a message online. We are here to help.';
const canonicalUrl = 'https://dralanlee.com/contact/';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: "Dr. Alan S. Lee, DDS",
  url: "https://dralanlee.com/contact/",
  telephone: "+1-209-239-2990",
  email: "info@dralanlee.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "715 N Main St",
    addressLocality: "Manteca",
    addressRegion: "CA",
    postalCode: "95336",
    addressCountry: "US"
  },
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday","Tuesday","Wednesday","Thursday"], opens: "08:00", closes: "16:30" }
  ],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: "+1-209-239-2990",
    contactType: "customer service",
    availableLanguage: "English"
  }
};
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} schema={localBusinessSchema}>
  <!-- Hero -->
  <section class="legal-hero" data-animate>
    <div class="container-wide">
      <div class="section-label">Get in Touch</div>
      <h1 class="section-title">Contact Our Office</h1>
      <p class="legal-hero-subtitle">We are here to answer your questions, schedule appointments, and help with anything you need.</p>
    </div>
  </section>

  <!-- Contact
  <!-- Trust Bar -->
  <section class="trust-bar" data-animate>
    <div class="container-narrow">
      <div class="trust-inner">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
        <span>Your information is encrypted and protected under HIPAA regulations. We never share your data with third parties.</span>
      </div>
    </div>
  </section>

 Grid -->
  <section class="section-pad">
    <div class="contact-grid">
      <!-- Contact Form: JotForm Embed -->
      <div class="form-column" data-animate>
        <!-- Form Tabs -->
        <div class="form-tabs">
          <button class="form-tab active" data-tab="appointment" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            Request Appointment
          </button>
          <button class="form-tab" data-tab="message" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            Send a Message
          </button>
        </div>

        <!-- Appointment Form -->
        <div class="form-panel active" id="panel-appointment">
          <div class="jotform-embed" id="appointment-form-container">
            <script type="text/javascript" src="https://form.jotform.com/jsform/260202986387060"></script>
          </div>
        </div>

        <!-- Contact Our Office -->
        <div class="form-panel" id="panel-message">
          <div class="jotform-embed" id="contact-form-container">
            <script type="text/javascript" src="https://form.jotform.com/jsform/261351664337155"></script>
          </div>
        </div>

        <noscript>
          <p>Your browser does not support JavaScript. Please <a href="https://form.jotform.com/jsform/261351664337155" target="_blank" rel="noopener noreferrer">fill out the contact form</a> directly.</p>
        </noscript>

        <div class="form-disclaimer">
          <div class="disclaimer-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
            <span>HIPAA-Encrypted Submission</span>
          </div>
          <p>By submitting this form, you consent to being contacted regarding your inquiry. Your information is handled in accordance with our <a href="/hipaa-privacy/">HIPAA Notice of Privacy Practices</a>.</p>
          <p class="ccpa-notice">\u2699\uFE0F <strong>Notice at Collection (CCPA):</strong> We collect your name, email, phone number, and message to respond to your inquiry. We do not sell your personal information. See our <a href="/privacy-policy/">Privacy Policy</a> for your California privacy rights.</p>
        </div>
      </div>

      <!-- Info Column -->
      <div class="info-column" data-animate>
        <div class="info-card">
          <div class="info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <h3>Call Us Directly</h3>
          <a href="tel:+12092392990" class="phone-large">(209) 239-2990</a>
          <p>For urgent dental needs, please call us directly.</p>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h3>Office Hours</h3>
          <div class="hours-grid">
            <div class="hours-row"><span>Monday</span><span>8:00 AM – 4:30 PM</span></div>
            <div class="hours-row"><span>Tuesday</span><span>8:00 AM – 4:30 PM</span></div>
            <div class="hours-row"><span>Wednesday</span><span>8:00 AM – 4:30 PM</span></div>
            <div class="hours-row"><span>Thursday</span><span>8:00 AM – 4:30 PM</span></div>
            <div class="hours-row closed"><span>Friday</span><span>Closed</span></div>
            <div class="hours-row closed"><span>Saturday</span><span>Closed</span></div>
            <div class="hours-row closed"><span>Sunday</span><span>Closed</span></div>
          </div>
        </div>

        <div class="info-card">
          <div class="info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <h3>Our Location</h3>
          <p>715 N Main St<br />Manteca, CA 95336</p>
          <a href="https://maps.google.com/?q=715+N+Main+St+Manteca+CA+95336" target="_blank" rel="noopener noreferrer" class="btn-directions">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="3 11 22 2 13 21 11 13 3 11"></polygon></svg>
            Get Directions
          </a>
        </div>

        <div class="info-card hipaa-card">
          <div class="info-icon shield">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
          </div>
          <h3>HIPAA Secure</h3>
          <p>Your information is encrypted and protected under HIPAA regulations. <a href="/hipaa-privacy/">Privacy Notice</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="section-pad" style="padding-top: 0;">
    <div class="container-narrow" data-animate>
      <div class="map-embed">
        <iframe src="https://maps.google.com/maps?q=715+N+Main+St+Manteca+CA+95336&output=embed" width="100%" height="350" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Dr. Alan S. Lee office location on Google Maps"></iframe>
      </div>
    </div>
  </section>

  <style>
    /* ===== HERO ===== */
    .legal-hero {
      background: linear-gradient(135deg, var(--primary-950) 0%, var(--primary-800) 100%);
      color: white; padding: 5rem 1.5rem 4rem; text-align: center;
    }
    .legal-hero .section-label { color: var(--accent-400); justify-content: center; }
    .legal-hero .section-label::before { background: var(--accent-400); }
    .legal-hero .section-title { color: white; margin-bottom: 1rem; }
    .legal-hero-subtitle { color: rgba(255,255,255,0.85); font-size: 1.1rem; max-width: 680px; margin: 0 auto; line-height: 1.7; font-weight: 300; }
    .trust-bar { background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 1rem 1.5rem; position: relative; overflow: hidden; }
    .trust-bar::before { content: ''; position: absolute; top: 0; right: 0; width: 200px; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06)); }
    .trust-inner { max-width: 800px; margin: 0 auto; display: flex; align-items: center; gap: 0.75rem; color: white; font-size: 0.9rem; font-weight: 500; position: relative; }
    .trust-inner svg { flex-shrink: 0; }

    /* ===== CONTACT GRID ===== */
    .contact-grid {
      display: grid; grid-template-columns: 1fr 400px; gap: 3rem;
      max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;
    }
    .form-column { min-width: 0; }
    .info-column { display: flex; flex-direction: column; gap: 1rem; }

    /* ===== FORM TABS — flush card tabs ===== */
    .form-tabs {
      display: flex; gap: 0; margin-bottom: 0;
      position: relative; z-index: 2;
    }
    .form-tab {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
      padding: 0.85rem 1.75rem; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.01em;
      font-family: var(--font-body);
      transition: all 0.25s ease; cursor: pointer;
      text-decoration: none; position: relative;
      background: var(--neutral-100); color: var(--neutral-500);
      border: 1px solid var(--neutral-200); border-bottom: none;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      margin-right: -1px;
    }
    .form-tab svg { flex-shrink: 0; width: 16px; height: 16px; }
    .form-tab:hover {
      background: var(--primary-50); color: var(--primary-700);
    }
    .form-tab.active {
      background: var(--neutral-50); color: var(--primary-700);
      border-color: var(--neutral-200);
      border-bottom: 2px solid var(--neutral-50);
      margin-bottom: -2px;
      z-index: 3;
      box-shadow: 0 -2px 4px rgba(2, 132, 199, 0.06);
    }
    .form-tab.active::after {
      content: ''; position: absolute; bottom: -1px; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--primary-500), var(--accent-400));
      border-radius: 3px 3px 0 0;
    }
    .form-tab:active { transform: none; }

    /* ===== FORM PANELS ===== */
    .form-panel { display: none; }
    .form-panel.active { display: block; animation: fadeInUp 0.35s ease-out; }
    .form-panel.active .jotform-embed { border-radius: 0 0 var(--radius-lg) var(--radius-lg); }

    /* ===== JOTFORM EMBED — JS embed container styling ===== */
    .jotform-embed {
      min-height: 600px; background: var(--neutral-50);
      border: 1px solid var(--neutral-200); border-top: 2px solid var(--primary-200);
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      overflow: hidden; position: relative;
      transition: min-height 0.3s ease;
    }
    /* JotForm JS embed renders inline — ensure it fills container */
    .jotform-embed > script + * {
      width: 100% !important;
    }

    /* ===== DISCLAIMER ===== */
    .form-disclaimer { margin-top: 1.25rem; padding: 1rem 1.25rem; background: var(--neutral-50); border-radius: var(--radius-md); border: 1px solid var(--neutral-200); }
    .disclaimer-badge {
      display: inline-flex; align-items: center; gap: 0.4rem;
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      color: white; font-size: 0.78rem; font-weight: 600;
      padding: 0.3rem 0.75rem; border-radius: var(--radius-full);
      margin-bottom: 0.6rem; letter-spacing: 0.02em;
    }
    .form-disclaimer p { color: var(--neutral-500); font-size: 0.85rem; line-height: 1.65; margin-bottom: 0.35rem; }
    .form-disclaimer p:last-child { margin-bottom: 0; }
    .form-disclaimer a { color: var(--primary-600); font-weight: 500; }
    .form-disclaimer a:hover { color: var(--primary-700); text-decoration: underline; }
    .ccpa-notice { font-size: 0.78rem !important; color: var(--neutral-400) !important; }

    /* ===== INFO CARDS ===== */
    .info-card {
      background: white; border: 1px solid var(--neutral-200); border-radius: var(--radius-lg);
      padding: 1.75rem; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative; overflow: hidden;
    }
    .info-card::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(2, 132, 199, 0.03) 0%, rgba(7, 89, 133, 0.06) 100%);
      opacity: 0; transition: opacity 0.4s;
    }
    .info-card:hover::before { opacity: 1; }
    .info-card:hover { box-shadow: 0 16px 40px rgba(2, 132, 199, 0.12), 0 4px 10px rgba(0,0,0,0.04); border-color: var(--primary-200); transform: translateY(-4px); }

    .info-icon {
      width: 52px; height: 52px; border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--primary-600) 0%, var(--primary-800) 100%); color: white;
      display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25); transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .info-card:hover .info-icon { transform: scale(1.08); box-shadow: 0 8px 24px rgba(2, 132, 199, 0.35); }
    .info-icon.shield { background: linear-gradient(135deg, #059669 0%, #047857 100%); color: white; box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25); }
    .info-card:hover .info-icon.shield { box-shadow: 0 8px 24px rgba(5, 150, 105, 0.35); }

    .info-card h3 { font-family: var(--font-body); font-weight: 600; font-size: 1.05rem; color: var(--neutral-900); margin-bottom: 0.5rem; transition: color 0.3s; }
    .info-card:hover h3 { color: var(--primary-700); }
    .info-card p { color: var(--neutral-600); font-size: 0.9rem; line-height: 1.65; }
    .phone-large { font-size: 1.6rem; font-weight: 700; color: var(--primary-700); display: block; margin-bottom: 0.5rem; transition: color 0.3s; letter-spacing: -0.01em; }
    .phone-large:hover { color: var(--primary-500); }

    /* Directions button — premium style */
    .btn-directions {
      display: inline-flex; align-items: center; gap: 0.45rem;
      background: linear-gradient(135deg, var(--primary-600) 0%, var(--primary-800) 100%);
      color: white; font-weight: 600; font-size: 0.85rem;
      padding: 0.6rem 1.3rem; border-radius: var(--radius-full);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 3px 10px rgba(2, 132, 199, 0.25);
      text-decoration: none; margin-top: 0.75rem;
    }
    .btn-directions:hover {
      transform: translateY(-2px); color: white;
      box-shadow: 0 6px 18px rgba(2, 132, 199, 0.4);
      background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-900) 100%);
    }
    .btn-directions svg { flex-shrink: 0; }

    /* HIPAA card */
    .hipaa-card { background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-color: #86efac; }

    /* Hours */
    .hours-grid { width: 100%; }
    .hours-row { display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.88rem; border-bottom: 1px solid var(--neutral-100); }
    .hours-row:last-child { border-bottom: none; }
    .hours-row span:first-child { color: var(--neutral-700); font-weight: 500; }
    .hours-row span:last-child { color: var(--neutral-600); }
    .hours-row.closed span:last-child { color: var(--neutral-400); font-style: italic; }

    /* Map */
    .map-embed { border-radius: var(--radius-xl); overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,0.08), 0 4px 10px rgba(0,0,0,0.04); border: 1px solid var(--neutral-200); }
    .map-embed iframe { display: block; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1024px) {
      .contact-grid { grid-template-columns: 1fr; }
      .info-column { order: 2; }
      .form-column { order: 1; }
    }
    @media (max-width: 768px) {
      .legal-hero { padding: 3.5rem 1rem 3rem; }
      .contact-grid { padding: 0 1rem; }
      .form-tabs { flex-direction: column; gap: 0.5rem; }
      .form-tab { width: 100%; justify-content: center; padding: 0.75rem 1.5rem; font-size: 0.85rem; }
      .jotform-embed { min-height: 500px; }
    }
  </style>

  <style>
    /* ===== ADA COMPLIANCE OVERRIDES for JotForm embed ===== */
    /* Fix low contrast on sub-labels (First Name, Last Name, etc.) */
    .jotform-embed .form-sub-label,
    .jotform-embed .form-sub-label-container label,
    .jotform-embed #sublabel_2_first,
    .jotform-embed #sublabel_2_last,
    .jotform-embed #sublabel_3_masked,
    .jotform-embed #sublabel_input_4 {
      color: #595959 !important;
      font-weight: 500 !important;
      font-size: 0.85rem !important;
    }
    /* Fix placeholder text contrast */
    .jotform-embed input::placeholder,
    .jotform-embed textarea::placeholder {
      color: #595959 !important;
      opacity: 1 !important;
    }
    /* WCAG 2.4.7 - Visible focus indicators */
    .jotform-embed input:focus-visible,
    .jotform-embed textarea:focus-visible,
    .jotform-embed select:focus-visible,
    .jotform-embed .form-textbox:focus,
    .jotform-embed .form-textarea:focus {
      outline: 2px solid #0C4A6E !important;
      outline-offset: 2px !important;
      box-shadow: 0 0 0 3px rgba(12, 74, 110, 0.15) !important;
    }
    /* Enhance radio button focus */
    .jotform-embed .form-radio-item input:focus-visible + label {
      outline: 2px solid #0C4A6E !important;
      outline-offset: 2px !important;
      border-radius: 4px !important;
    }
    /* Make PHI warning prominent - yellow banner style */
    .jotform-embed #text_9 p,
    .jotform-embed .form-html p {
      color: #92400E !important;
      background: #FEF3C7 !important;
      padding: 12px !important;
      border-radius: 6px !important;
      font-weight: 600 !important;
      border-left: 4px solid #F59E0B !important;
      margin: 1rem 0 !important;
    }
    /* Ensure submit button has proper contrast */
    .jotform-embed .form-submit-button {
      background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
      color: white !important;
      font-weight: 600 !important;
      padding: 0.85rem 2rem !important;
      border-radius: 9999px !important;
      border: none !important;
      cursor: pointer !important;
      transition: all 0.3s ease !important;
    }
    .jotform-embed .form-submit-button:hover {
      transform: translateY(-2px) !important;
      box-shadow: 0 6px 18px rgba(2, 132, 199, 0.35) !important;
    }
    .jotform-embed .form-submit-button:focus-visible {
      outline: 2px solid #0C4A6E !important;
      outline-offset: 2px !important;
    }
    /* Required field indicators - ensure high contrast */
    .jotform-embed .form-required {
      color: #dc2626 !important;
      font-weight: 700 !important;
    }
    /* Error messages - high contrast */
    .jotform-embed .form-error-message,
    .jotform-embed .error-div {
      color: #991b1b !important;
      background: #fef2f2 !important;
      border: 1px solid #fecaca !important;
      border-radius: 6px !important;
      padding: 8px 12px !important;
      font-weight: 500 !important;
    }
    /* Ensure labels are clearly visible */
    .jotform-embed .form-label {
      color: #1e293b !important;
      font-weight: 600 !important;
      font-size: 0.95rem !important;
    }
    /* Improve radio button labels */
    .jotform-embed .form-radio-item label {
      color: #334155 !important;
      font-weight: 500 !important;
      font-size: 0.9rem !important;
    }
    /* HIPAA consent checkbox styling (injected via JS) */
    .hipaa-consent-container {
      background: #f0fdf4 !important;
      border: 2px solid #86efac !important;
      border-radius: 8px !important;
      padding: 1rem 1.25rem !important;
      margin: 1rem 0 !important;
    }
    .hipaa-consent-container label {
      color: #166534 !important;
      font-weight: 600 !important;
      font-size: 0.9rem !important;
      line-height: 1.5 !important;
    }
    .hipaa-consent-container input[type="checkbox"] {
      width: 20px !important;
      height: 20px !important;
      accent-color: #059669 !important;
      cursor: pointer !important;
    }
    /* Encryption notice styling */
    .encryption-notice {
      background: #eff6ff !important;
      border: 1px solid #bfdbfe !important;
      border-radius: 6px !important;
      padding: 10px 14px !important;
      margin: 0.75rem 0 !important;
      color: #1e40af !important;
      font-size: 0.85rem !important;
      font-weight: 500 !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
    }
  </style>

  <script>
    // Tab switching for contact forms
    document.querySelectorAll('.form-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        // Update tabs
        document.querySelectorAll('.form-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        // Update panels
        document.querySelectorAll('.form-panel').forEach(p => p.classList.remove('active'));
        const panel = document.getElementById('panel-' + target);
        panel.classList.add('active');
      });
    });

    // HIPAA Compliance Enhancement - Inject consent checkbox after form loads
    function injectHIPAACompliance() {
      // Wait for JotForm to render
      setTimeout(() => {
        const forms = document.querySelectorAll('.jotform-embed');
        forms.forEach(formContainer => {
          const jotformWrapper = formContainer.querySelector('[id^="2602"], [id^="2613"]');
          if (jotformWrapper) {
            // Check if consent checkbox already exists
            if (!formContainer.querySelector('.hipaa-consent-container')) {
              const consentDiv = document.createElement('div');
              consentDiv.className = 'hipaa-consent-container';
              consentDiv.innerHTML = `
                <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
                  <input type="checkbox" required style="margin-top: 2px; flex-shrink: 0;" 
                         onchange="this.setCustomValidity(this.checked ? '' : 'You must consent to proceed with your inquiry.')">
                  <span>I consent to being contacted regarding my dental inquiry. I understand my information will be handled per the <a href="/hipaa-privacy/" target="_blank" style="color: #059669; text-decoration: underline;">HIPAA Notice of Privacy Practices</a>. *</span>
                </label>
              `;
              
              // Insert before submit button or at end of form
              const submitButton = jotformWrapper.querySelector('.form-buttons-wrapper');
              if (submitButton) {
                submitButton.parentNode.insertBefore(consentDiv, submitButton);
              } else {
                formContainer.appendChild(consentDiv);
              }
            }
            
            // Add encryption notice
            if (!formContainer.querySelector('.encryption-notice')) {
              const encryptionDiv = document.createElement('div');
              encryptionDiv.className = 'encryption-notice';
              encryptionDiv.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                <span>This form uses HIPAA-compliant encryption. Your data is protected end-to-end.</span>
              `;
              
              const submitButton = jotformWrapper.querySelector('.form-buttons-wrapper');
              if (submitButton) {
                submitButton.parentNode.insertBefore(encryptionDiv, submitButton);
              }
            }
          }
        });
      }, 3000); // Wait 3 seconds for JotForm to fully render
    }

    // Run on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectHIPAACompliance);
    } else {
      injectHIPAACompliance();
    }

    // Also run when tab is switched (forms may re-render)
    document.querySelectorAll('.form-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        injectHIPAACompliance();
      });
    });
  </script>
</Layout>